  "components": {
    "schemas": {
      "CreatePropertyRequest": {
        "required": [
          "name",
          "currency",
          "timezone",
          "country_code",
          "city"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "timezone": {
            "maxLength": 64,
            "type": "string"
          },
          "country_code": {
            "maxLength": 2,
            "minLength": 2,
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "type": "string"
          },
          "address": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          },
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "CreateRatePlanRequest": {
        "required": [
          "room_type_id",
          "code",
          "name",
          "sell_mode",
          "meal_plan",
          "child_fee"
        ],
        "type": "object",
        "properties": {
          "room_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "maxLength": 50,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "sell_mode": {
            "$ref": "#/components/schemas/SellMode"
          },
          "meal_plan": {
            "$ref": "#/components/schemas/MealPlan"
          },
          "child_fee": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "occupancies": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/OccupancyDto"
            }
          },
          "derived": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DerivedPricingDto"
              }
            ]
          }
        }
      },
      "CreateRoomTypeRequest": {
        "required": [
          "code",
          "name",
          "count_of_rooms",
